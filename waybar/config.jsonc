[
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "pulseaudio",
    "temperature",
    "cpu",
    "memory",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "disable-scroll": true,
    "all-outputs": true
  },

  "clock": {
    "format": "  {:%H:%M}",
    "tooltip-format": "{:%A %d %B %Y}"
  },

  "cpu": {
    "format": " {usage}%"
  },

  "memory": {
    "format": " {}%"
  },

  "temperature": {
    "thermal-zone": 0,
    "critical-threshold": 80,
    "format": " {temperatureC}°C"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    }
  },

  "tray": {
    "spacing": 10
  },

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun"
  }
}
]
